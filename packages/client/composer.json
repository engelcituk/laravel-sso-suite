{
    "name": "laravel-sso/client",
    "description": "Experimental OIDC client for native Laravel Auth and local Eloquent identities",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "ext-openssl": "*",
        "laravel-sso/contracts": "^0.1@dev",
        "illuminate/auth": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "firebase/php-jwt": "^7.0"
    },
    "autoload": {"psr-4": {"LaravelSso\\Client\\": "src/"}},
    "extra": {"laravel": {"providers": ["LaravelSso\\Client\\SsoClientServiceProvider"]}}
}
